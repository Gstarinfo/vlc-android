<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subtitle_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Baseline reference line representing default 0 px -->
    <View
        android:id="@+id/subtitle_baseline_guide"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.85" />

    <TextView
        android:id="@+id/subtitle_baseline_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:text="@string/subtitles_position_default"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle_baseline_guide"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Ghost subtitle drag box -->
    <LinearLayout
        android:id="@+id/subtitle_ghost_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_subtitle_ghost_preview"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_baseline_guide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/subtitle_ghost_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sample Subtitles Preview"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle_ghost_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle_drag_hint"
            android:textColor="@color/orange500"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Top floating control pill -->
    <LinearLayout
        android:id="@+id/subtitle_editor_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_subtitle_editor_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/subtitles_position"
                app:srcCompat="@drawable/ic_subtitles"
                app:tint="@color/orange500" />

            <TextView
                android:id="@+id/subtitle_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/subtitles_position"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle_editor_offset_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/subtitles_position_default"
                android:textColor="@color/orange500"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/subtitle_btn_up"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Move up"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_chevron_up"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/subtitle_btn_down"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Move down"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_chevron_down"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/subtitle_btn_reset"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/subtitles_reset_action"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_reset"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/subtitle_btn_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="@string/subtitle_position_done"
                android:textColor="@color/orange500"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Presets Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_preset_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_subtitle_preset_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:text="@string/subtitle_position_bottom"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_preset_middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_subtitle_preset_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:text="@string/subtitle_position_middle"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_preset_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_subtitle_preset_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:text="@string/subtitle_position_top"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
